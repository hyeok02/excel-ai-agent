SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=50MB
UPLOAD_DIR=./uploads
UPLOAD_RETENTION=1d
UPLOAD_CLEANUP_INTERVAL=1h
UPLOAD_CLEANUP_INITIAL_DELAY=1m
ANALYSIS_ASYNC_ENABLED=true
DB_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1
DB_USERNAME=EXCEL_AI_AGENT
DB_PASSWORD=change-me
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_CONNECT_TIMEOUT=3s
AI_SERVICE_READ_TIMEOUT=150s
AUTH_SECURITY_ENABLED=true
FRONTEND_BASE_URL=http://localhost:5173
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin1234
BOOTSTRAP_ADMIN_DISPLAY_NAME=System Administrator
SSO_ENABLED=false
SSO_REGISTRATION_ID=company
SSO_ALLOWED_DOMAIN=company.com
SSO_AUTO_PROVISION=true
# SSO_ENABLED=true일 때 사용하는 표준 OIDC 설정
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_COMPANY_CLIENT_ID=change-me
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_COMPANY_CLIENT_SECRET=change-me
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_COMPANY_SCOPE=openid,profile,email
# SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_COMPANY_ISSUER_URI=https://login.company.com/realms/company
