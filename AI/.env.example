OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FAST_MODEL=gpt-4.1-mini
OPENAI_STANDARD_MODEL=gpt-4.1-mini
OPENAI_PRECISE_MODEL=gpt-4.1
OPENAI_PLANNER_MODEL=gpt-4.1-mini
OPENAI_AGENT_INSIGHT_MODEL=gpt-4.1-mini
OPENAI_QA_MODEL=gpt-4.1-2025-04-14
# 질문 해석 계획의 무작위성. 비우면 설정하지 않는다(temperature를 받지 않는 모델용).
OPENAI_INTENT_TEMPERATURE=0
OPENAI_WRITEBACK_MODEL=gpt-4.1-2025-04-14
OPENAI_TIMEOUT_SECONDS=120
OPENAI_REASONING_EFFORT=minimal
OPENAI_MAX_COMPLETION_TOKENS=2500
