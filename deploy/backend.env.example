SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://replace-with-public-host
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=50MB
UPLOAD_DIR=/data/uploads
UPLOAD_RETENTION=7d
UPLOAD_CLEANUP_INTERVAL=1h
UPLOAD_CLEANUP_INITIAL_DELAY=1m
ANALYSIS_ASYNC_ENABLED=true
DB_URL=jdbc:oracle:thin:@//oracle:1521/XEPDB1
DB_USERNAME=EXCEL_AI_AGENT
DB_PASSWORD=replace-with-the-same-app-password-as-oracle-env
AI_SERVICE_BASE_URL=http://ai:8000
AI_SERVICE_CONNECT_TIMEOUT=3s
AI_SERVICE_READ_TIMEOUT=150s
AUTH_SECURITY_ENABLED=true
FRONTEND_BASE_URL=http://replace-with-public-host
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
BOOTSTRAP_ADMIN_DISPLAY_NAME=System Administrator
SSO_ENABLED=false
