FROM node:22-alpine AS build

WORKDIR /app

COPY FE/package.json FE/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY FE ./

ARG VITE_API_BASE_URL=
ARG VITE_API_TIMEOUT=180000
ARG VITE_ANALYSIS_TIMEOUT=180000
ARG VITE_ANALYSIS_POLL_INTERVAL=1000

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_API_TIMEOUT=${VITE_API_TIMEOUT} \
    VITE_ANALYSIS_TIMEOUT=${VITE_ANALYSIS_TIMEOUT} \
    VITE_ANALYSIS_POLL_INTERVAL=${VITE_ANALYSIS_POLL_INTERVAL}

RUN npm run build

FROM nginx:1.28-alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
  CMD ["wget", "--quiet", "--tries=1", "--spider", "http://127.0.0.1/healthz"]
